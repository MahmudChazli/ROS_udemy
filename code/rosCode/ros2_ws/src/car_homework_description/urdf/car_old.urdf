<?xml version = "1.0"?>
<robot name = "robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!--***Colors**************************************************-->

  <material name = "cyan">
    <color rgba = "0 1 1 1"/>
  </material>  

  <material name = "black">
    <color rgba = "0 0 0 1"/>
  </material>

<!--***Xacro*Property******************************************--> 

  <xacro:property name="base_width" value="0.6"/>
  <xacro:property name="base_length" value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>

  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_length" value="0.05"/>
  <xacro:property name="front_wheel_radius" value="0.06"/>



<!--***********************************************************-->


  <xacro:macro name = "wheel_link" params = "side radius">
    <link name = "${side}_wheel_link">
      <visual>

        <geometry>
          <cylinder radius="${radius}" length="${wheel_length}"/>
        </geometry>

        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name = "black"/>        

      </visual>
    </link>
  </xacro:macro>

  <link name = "base_foot_link"/>


  <link name = "base_link">
    <visual>

      <geometry>
        <box size = "${base_width} ${base_length} ${base_height}"/>
      </geometry>

      <material name = "cyan"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>

    </visual>
  </link>

  <xacro:wheel_link side="right" radius="${wheel_radius}"/>
  <xacro:wheel_link side="left" radius="${wheel_radius}"/>
  <xacro:wheel_link side="front" radius="${front_wheel_radius}"/>
  

  <joint name="base_joint" type="fixed">
    <parent link = "base_foot_link"/>
    <child link = "base_link"/>

    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <joint name="base_right_wheel_joint" type="continuous">
    <parent link = "base_link"/>
    <child link = "right_wheel_link"/>

    <origin xyz="${0.01 -(base_length/2)}
                 ${(wheel_radius + 0.01) - (base_width/2)}
                 0"
                 rpy="0 0 0"/>
    <axis xyz = "0 1 0"/>
  </joint>

  <joint name="base_left_wheel_joint" type="continuous">
    <parent link = "base_link"/>
    <child link = "left_wheel_link"/>

    <origin xyz="${0.01 -(base_length/2)}
                 ${(base_width/2) - (wheel_radius + 0.01)}
                 0"
                 rpy="0 0 0"/>
    <axis xyz = "0 1 0"/>
  </joint>

  <joint name="base_front_wheel_joint" type="continuous">
    <parent link = "base_link"/>
    <child link = "front_wheel_link"/>

    <origin xyz="${base_length / 2 - 0.02}
                 0
                 ${front_wheel_radius - wheel_radius}"
                 rpy="0 0 0"/>
    <axis xyz = "0 1 0"/>
  </joint>

</robot>