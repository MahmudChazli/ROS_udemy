<?xml version="1.0"?>
<robot name="simple_robot">

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>

  <material name="green">
    <color rgba="0 1 0 1" />
  </material>

  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>


  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="1" radius="0.5"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
  </link>

  <link name="second_link">
    <visual>
      <geometry>
        <box size="0.5 1 1"/>
      </geometry>
      <material name="blue"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <link name="third_link">
    <visual>
      <geometry>
        <sphere radius="0.5"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0.5" rpt="0 0 0"/>
  </joint>

  <joint name="base_second_joint" type="continuous">
    <parent link="base_link"/>
    <child link="second_link"/>
    <origin xyz="1 1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" velocity="100" effort="100"/>
  </joint>

  <joint name="second_third_joint" type="prismatic">
    <parent link="second_link"/>
    <child link="third_link"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <limit lower="-1" upper="1" velocity="100" effort="100"/>
  </joint>

</robot>