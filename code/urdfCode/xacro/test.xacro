<?xml version="1.0"?>
<robot name="test" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name = "base_width" value = "0.5"/>
  <xacro:property name = "base_length" value = "1"/>
  <xacro:property name = "base_height" value = "0.7"/>

  <link name="base_link">
    <visual>
      <geometry>
        <sphere radius="0.5"/>
      </geometry>
      <material name="red"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </visual>
  </link>

  <xacro:macro name="arm_link" params="prefix">
    <link name="${prefix}_arm_link">
      <visual>
        <geometry>
          <box size="${base_width} ${base_length} ${base_height}"/>
        </geometry>
        <material name="green"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </visual>
    </link>
  </xacro:macro> 

  <xacro:arm_link prefix = "right"/>

  <joint name="base_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_arm_link"/>

    <origin xyz="0 0 1.5" rpy="0 0 0"/>
  </joint>

</robot>